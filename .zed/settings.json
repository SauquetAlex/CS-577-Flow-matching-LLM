{
  "languages": {
    "Python": {
      "language_servers": ["ty", "ruff", "!basedpyright", "!pyright", "!pylsp"],
      "formatter": { "language_server": { "name": "ruff" } },
      "code_actions_on_format": { "source.organizeImports.ruff": true },
      "format_on_save": "on",
    },
  },
  "lsp": {
    "ty": { "binary": { "path": ".venv/bin/ty", "arguments": ["server"] } },
    "ruff": { "binary": { "path": ".venv/bin/ruff", "arguments": ["server"] } },
  },
}
